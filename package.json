{
  "name": "marktext-monorepo",
  "version": "0.22.0",
  "description": "MarkText monorepo root",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/muya/examples",
    "packages/muya/e2e"
  ],
  "homepage": "https://github.com/shekel588/marktext",
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "rebuild-native": "bun --filter marktext rebuild-native",
    "start": "bun --filter marktext start",
    "dev": "bun --filter marktext dev",
    "build": "bun --filter marktext build",
    "build:unpack": "bun --filter marktext build:unpack",
    "build:win": "bun --filter marktext build:win",
    "build:win:x64": "bun --filter marktext build:win:x64",
    "build:win:arm64": "bun --filter marktext build:win:arm64",
    "build:mac": "bun --filter marktext build:mac",
    "build:mac:x64": "bun --filter marktext build:mac:x64",
    "build:mac:arm64": "bun --filter marktext build:mac:arm64",
    "build:linux": "bun --filter marktext build:linux",
    "perf:inspect": "bun --filter marktext perf:inspect",
    "perf:inspect-brk": "bun --filter marktext perf:inspect-brk",
    "test": "bun --filter marktext test",
    "test:unit": "bun --filter marktext test:unit",
    "test:e2e": "bun --filter marktext test:e2e",
    "typecheck": "bun --filter marktext typecheck",
    "typecheck:watch": "bun --filter marktext typecheck:watch",
    "check": "bun run lint && bun run typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/desktop/src/**/*.{ts,vue}": [
      "eslint --fix"
    ],
    "packages/desktop/test/**/*.ts": [
      "eslint --fix"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "electron": "~42.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.6.0",
    "neostandard": "^0.14.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "postcss": "8.5.29",
    "esbuild@>=0.27.0 <0.28.1": "0.28.1",
    "file-icons": "npm:is-plain-obj@4.1.0"
  }
}
